{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aria.local/automation/task-schema.json",
  "title": "ARIA Phase 2 normalized task packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_digest",
    "created_at",
    "workspace",
    "user_request",
    "input_source",
    "scope",
    "canonical_files",
    "allowed_paths",
    "forbidden_paths",
    "required_evidence",
    "current_stage",
    "status",
    "attempt_count"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^aria-[0-9]{8}T[0-9]{6}-[a-f0-9]{8}$" },
    "task_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "workspace": { "type": "string", "minLength": 1 },
    "user_request": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "input_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["text", "json_file"] },
        "file_name": { "type": ["string", "null"] }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "enforced"],
      "properties": {
        "requested": { "type": ["string", "null"] },
        "enforced": { "const": "PHASE_2_INTAKE_ONLY" }
      }
    },
    "canonical_files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "allowed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "required_evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "current_stage": { "enum": ["RECEIVED", "CONTEXT_LOAD", "PRECHECK", "READY_FOR_ROUTING", "STOP"] },
    "status": { "enum": ["RUNNING", "INTERRUPTED", "FAILED", "COMPLETED"] },
    "attempt_count": { "type": "integer", "minimum": 1 }
  }
}
