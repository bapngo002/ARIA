# Load into the app process environment. Never commit real keys.
# Leave AI unconfigured to run the UI and local commands without cloud calls.
OPENAI_API_KEY=
ARIA_OPENAI_MODEL=
GEMINI_API_KEY=
ARIA_GEMINI_MODEL=

# Optional local voice. Use actual installed paths; models are not downloaded.
ARIA_WHISPER_BIN=
ARIA_WHISPER_MODEL=
ARIA_PIPER_BIN=
ARIA_PIPER_MODEL=
# ALSA device names from aplay -L / arecord -L; do not assume card numbers.
ARIA_CAPTURE_DEVICE=
ARIA_PLAYBACK_DEVICE=
